---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Figure from '../../components/Figure.astro';
import { illustrationFor } from '../../lib/illustration';

const berita = (await getCollection('berita'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<Layout title="Catatan lapangan | Banyubiru" description="Catatan, rekap kegiatan, dan cerita lapangan FTI di Desa Kebondowo.">
  <section class="wrap pt-10 sm:pt-14">
    <h1 class="mt-4 max-w-[18ch] font-display text-[clamp(2.4rem,4.4vw,4.25rem)] font-semibold leading-[1] tracking-tightest">
      Catatan dari tanah desa.
    </h1>
    <p class="lede mt-6">
      Catatan, rekap kegiatan, dan cerita lapangan dari berbagai program pengabdian
      FTI di Kecamatan Banyubiru.
    </p>
  </section>

  <section class="wrap mt-section-s">
    <div class="space-y-12">
      {berita.map((post) => (
        <article class="group grid gap-6 md:grid-cols-[16fr_8fr] md:items-start">
          <div class="aspect-[16/9] overflow-hidden rounded-xl border border-line bg-paper">
            <Figure
              src={illustrationFor(post.data.category)}
              alt={`Ilustrasi untuk catatan: ${post.data.title}`}
              ratio="aspect-[16/9]"
              caption={`Foto ilustrasi. Dokumentasi kegiatan menyusul. — ${post.data.title}`}
            />
          </div>
          <div class="space-y-3">
            <p class="label">{formatDate(post.data.publishDate)}</p>
            <h3 class="font-display text-2xl font-semibold tracking-tight text-ink">
              <a href={`/berita/${post.id}`} class="underline decoration-line underline-offset-4 hover:text-danau">
                {post.data.title}
              </a>
            </h3>
            <p class="text-sm leading-relaxed text-ink-soft">
              {post.data.summary}
            </p>
            <p class="text-xs text-ink-mute">
              {post.data.author} · {post.data.readTime}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      <div class="border border-line bg-paper-light p-6">
        <h2 class="font-display font-semibold leading-[1.05] tracking-display text-[var(--text-section)]">Pembahasan</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Pilihan catatan dari wawasan teknologi, inovasi pangan, dan digitalisasi lapangan.
        </p>
      </div>
      <div class="border border-line bg-paper-light p-6">
        <h2 class="font-display font-semibold leading-[1.05] tracking-display text-[var(--text-section)]">Kontributor</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Catatan ditulis oleh Divisi Media &amp; IT FTI, dipantau dari tim pengabdian.
        </p>
      </div>
    </div>
  </section>
</Layout>