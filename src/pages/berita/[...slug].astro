---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Figure from '../../components/Figure.astro';
import { illustrationFor } from '../../lib/illustration';

export async function getStaticPaths() {
  const entries = await getCollection('berita');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

const shareText = encodeURIComponent(`${entry.data.title} ${Astro.url.href}`);
---

<Layout title={entry.data.title} description={entry.data.summary} type="article">
  <article class="wrap pt-8 sm:pt-10">
    <nav class="text-sm text-ink-mute" aria-label="Remah roti">
      <a href="/berita" class="underline decoration-line underline-offset-4 hover:text-ink">
        Catatan
      </a>
      <span class="px-2" aria-hidden="true">/</span>
      <span class="text-ink-soft">{entry.data.category}</span>
    </nav>

    <header class="mt-8 max-w-3xl">
      <p class="label">{formatDate(entry.data.publishDate)}</p>
      <h1 class="mt-3 font-display text-[clamp(2.1rem,4.8vw,3.6rem)] font-semibold leading-[1.03] tracking-tightest">
        {entry.data.title}
      </h1>
      <p class="lede mt-5">{entry.data.summary}</p>
      <p class="mt-6 border-t border-line pt-4 text-sm text-ink-mute">
        Oleh {entry.data.author} · {entry.data.readTime}
      </p>
    </header>

    <div class="mt-10">
      <Figure
        src={illustrationFor(entry.data.category)}
        alt={`Ilustrasi untuk catatan: ${entry.data.title}`}
        ratio="aspect-[16/9]"
        caption="Foto ilustrasi. Dokumentasi kegiatan menyusul."
        priority
      />
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-8">
        <div class="prose-editorial">
          <Content />
        </div>

        <div class="mt-14 border-t border-line pt-6">
          <p class="text-sm leading-relaxed text-ink-soft">
            <span class="font-semibold text-ink">Tentang penulis.</span>
            Divisi Media &amp; IT FTI menulis dan menyunting catatan lapangan
            pengabdian di Desa Kebondowo.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line pt-6">
          <span class="text-sm text-ink-mute">Bagikan</span>
          <a
            href={`https://wa.me/?text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-line min-h-[44px] px-4 py-2"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-line min-h-[44px] px-4 py-2"
          >
            X / Twitter
          </a>
          <a href="/berita" class="link-more ml-auto">Kembali ke catatan</a>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="top-24 space-y-6 lg:sticky">
          <div class="border border-line bg-paper-light p-6">
            <h2 class="text-sm font-semibold text-ink">Ringkas</h2>
            <dl class="mt-3 divide-y divide-line text-sm">
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Kategori</dt>
                <dd class="text-right font-semibold text-ink">{entry.data.category}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Tanggal</dt>
                <dd class="text-right font-semibold text-ink">{formatDate(entry.data.publishDate)}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Bacaan</dt>
                <dd class="text-right font-semibold text-ink">{entry.data.readTime}</dd>
              </div>
            </dl>
          </div>

          <div class="border border-line bg-paper-light p-6">
            <h2 class="text-sm font-semibold text-ink">Ikuti jejaknya</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              Program kerja yang disebut dalam catatan ini punya halaman
              sendiri, lengkap dengan lokasi dan luarannya.
            </p>
            <a href="/proker" class="link-more mt-1">Lihat program kerja</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>