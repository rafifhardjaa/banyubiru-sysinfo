---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveBeritaImage } from '../../lib/beritaAssets';

export async function getStaticPaths() {
  const entries = await getCollection('berita');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const titleShort = entry.data.title.length > 50 ? entry.data.title.slice(0, 50) + '…' : entry.data.title;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<Layout title={entry.data.title}>
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm font-semibold text-slate-400">
        <a href="/" class="transition-colors hover:text-brand-700">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <a href="/berita" class="transition-colors hover:text-brand-700">Berita</a>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <span class="truncate text-slate-600">{titleShort}</span>
      </nav>

      <header class="mt-10">
        <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
          {entry.data.category}
        </span>
        <h1 class="mt-5 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl lg:text-5xl">
          {entry.data.title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm font-semibold text-slate-400">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            {entry.data.author}
          </span>
          <span class="inline-block h-1 w-1 rounded-full bg-slate-300"></span>
          <time datetime={entry.data.publishDate.toISOString()}>
            {formatDate(entry.data.publishDate)}
          </time>
          <span class="inline-block h-1 w-1 rounded-full bg-slate-300"></span>
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {entry.data.readTime}
          </span>
        </div>
      </header>

      <div class="relative mt-10 aspect-[16/9] overflow-hidden rounded-3xl shadow-md">
        <Image
          src={resolveBeritaImage(entry.id)}
          alt={entry.data.title}
          width={1200}
          height={675}
          class="h-full w-full object-cover"
        />
      </div>

      <article class="prose prose-slate mt-12 max-w-none lg:prose-lg prose-headings:text-slate-900 prose-a:text-brand-700">
        <Content />
      </article>

      <div class="mt-16 rounded-[2rem] bg-slate-50 p-6 sm:p-8">
        <div class="flex items-start gap-4 sm:items-center">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-700 text-lg font-extrabold text-white shadow-sm">
            HM
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-900">Humas & Redaksi Mahasiswa FTI</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Divisi Media & IT FTI — Tim redaksi yang bertanggung jawab atas publikasi, dokumentasi,
            dan penyebarluasan informasi kegiatan pengabdian masyarakat FTI di Banyubiru.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-8">
        <a
          href="/berita"
          class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-bold text-brand-700 transition-all hover:-translate-y-0.5 hover:border-brand-100 hover:bg-brand-50 hover:shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Kembali ke Kabar Berita
        </a>

        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Bagikan</span>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
            aria-label="Bagikan ke Twitter"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(entry.data.title + ' ' + Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
            aria-label="Bagikan ke WhatsApp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>