---
import Layout from '../layouts/Layout.astro';
import UmkmCard from '../components/UmkmCard.astro';
import EndNote from '../components/EndNote.astro';
import { getCollection } from 'astro:content';

const umkmList = (await getCollection('umkm')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="UMKM warga | Banyubiru"
  description="Direktori usaha warga Desa Kebondowo hasil pendampingan FTI: olahan pangan, kerajinan, dan minuman tradisional, lengkap dengan kontak penjual."
>
  <section class="wrap pt-6 sm:pt-8">
    <h1 class="mt-4 max-w-[18ch] text-[clamp(2.4rem,4.4vw,4.25rem)]">
      Usaha kecil yang menjaga desa tetap hidup.
    </h1>
    <p class="lede mt-6">
      Enam usaha warga yang didampingi tim pengabdian. Setiap entri memuat
      pemilik, lokasi dusun, dan kontak WhatsApp yang bisa langsung dihubungi.
    </p>
  </section>

  <section class="wrap mt-section-s">
    {
      umkmList.length === 0 ? (
        <p class="border-t border-ink/30 py-8 text-base text-ink-soft">
          Direktori masih kosong. Data usaha akan diisi setelah pendataan
          bersama perangkat desa.
        </p>
      ) : (
        umkmList.map((item, index) => (
          <UmkmCard umkm={item} index={index} flip={index % 2 === 1} />
        ))
      )
    }
  </section>

  <EndNote
    date="Pendaftaran UMKM"
    title="Punya usaha di Banyubiru?"
    body="Tim pengabdian membantu pembuatan katalog dan foto produk tanpa biaya. Hubungi posko untuk menjadwalkan pendataan."
    href="/kontak"
    linkLabel="Hubungi posko"
  />
</Layout>