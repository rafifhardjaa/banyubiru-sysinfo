---
import Layout from '../layouts/Layout.astro';
import { photos } from '../lib/photos';
const mapEmbedUrl =
  'https://maps.google.com/maps?q=Kebondowo%2C%20Kec.%20Banyubiru%2C%20Kabupaten%20Semarang%2C%20Jawa%20Tengah&z=14&output=embed';
---

<Layout
  title="Kontak & layanan | Banyubiru"
  description="Hubungi posko pengabdian FTI di Desa Kebondowo: alamat, jam layanan, formulir aspirasi, dan peta lokasi."
>
  <section class="wrap pt-0 sm:pt-0 min-h-[700px] flex flex-col items-center justify-center">
    <h1 class="mt-4 max-w-[18ch] font-display text-[clamp(3rem,6.5vw,5rem)] font-semibold leading-[1] tracking-tightest">
      Posko pengabdian terbuka untuk warga.
    </h1>
    <p class="lede mt-6">
      Sampaikan aspirasi, daftarkan usaha, atau tanyakan jadwal kegiatan. Tim
      akan membalas pada hari kerja.
    </p>
  </section>

  <section class="wrap mt-section-s grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <form
        action="https://formspree.io/f/mjyvvbwa"
        method="post"
        class="border border-ink/30 bg-paper-light p-6 sm:p-8"
      >
        <h2 class="font-display text-[var(--text-section)] font-semibold tracking-tight">
          Formulir pesan & aspirasi
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Formulir dikirim melalui Formspree. Kolom bertanda wajib harus diisi.
        </p>

        <div class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="nama" class="block text-sm font-semibold text-ink">
                Nama <span class="text-ink">*</span>
              </label>
              <input
                id="nama"
                name="nama"
                type="text"
                required
                autocomplete="name"
                placeholder="Nama lengkap"
                class="mt-1.5 w-full border border-ink bg-paper px-3.5 py-3 text-base text-ink placeholder:text-ink-mute/70 focus:border-danau focus:outline-none focus:ring-2 focus:ring-danau/20"
              />
            </div>
            <div>
              <label for="kontak" class="block text-sm font-semibold text-ink">
                Email atau WhatsApp <span class="text-ink">*</span>
              </label>
              <input
                id="kontak"
                name="kontak"
                type="text"
                required
                autocomplete="email"
                placeholder="email@contoh.com atau 08xx"
                class="mt-1.5 w-full border border-ink bg-paper px-3.5 py-3 text-base text-ink placeholder:text-ink-mute/70 focus:border-danau focus:outline-none focus:ring-2 focus:ring-danau/20"
              />
            </div>
          </div>

          <div>
            <label for="subjek" class="block text-sm font-semibold text-ink">
              Subjek
            </label>
            <select
              id="subjek"
              name="subjek"
              class="mt-1.5 w-full border border-ink bg-paper px-3.5 py-3 text-base text-ink focus:border-danau focus:outline-none focus:ring-2 focus:ring-danau/20"
            >
              <option>Informasi program pengabdian</option>
              <option>Pendaftaran UMKM</option>
              <option>Kerja sama atau kunjungan</option>
            </select>
          </div>

          <div>
            <label for="pesan" class="block text-sm font-semibold text-ink">
              Pesan <span class="text-ink">*</span>
            </label>
            <textarea
              id="pesan"
              name="pesan"
              rows="3"
              required
              placeholder="Isi pesan atau aspirasi Anda"
              class="mt-1.5 w-full border border-ink bg-paper px-3.5 py-3 text-base text-ink placeholder:text-ink-mute/70 focus:border-danau focus:outline-none focus:ring-2 focus:ring-danau/20"
></textarea>
          </div>

          <button
            type="submit"
            class="mt-6 w-full rounded-full bg-accent px-8 py-3 font-bold text-ink shadow-sm transition-all hover:bg-accent/90"
          >
            Kirim Aspirasi
          </button>
        </div>
      </form>
    </div>

    <div class="lg:col-span-5">
      <p class="label mt-8">Kontak & layanan</p>
      <div class="mt-8 rounded-[2rem] border border-ink bg-paper-deep p-8 text-ink">
        <h2 class="flex items-center gap-3 text-[var(--text-section)] font-bold tracking-tight">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-paper/10 text-ink/60">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          Info Akses & Rute
        </h2>
        <ul class="mt-5 space-y-4 text-sm text-ink-mute">
          <li class="flex items-start gap-3">
            <span class="text-ink">•</span>
            22 km dari Ibu Kota Kabupaten Semarang (Ungaran).
          </li>
          <li class="flex items-start gap-3">
            <span class="text-ink">•</span>
            Hanya 4 km dari pusat kota Ambarawa.
          </li>
          <li class="flex items-start gap-3">
            <span class="text-ink">•</span>
            Terjangkau via transportasi umum trayek Semarang - Ambarawa.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>