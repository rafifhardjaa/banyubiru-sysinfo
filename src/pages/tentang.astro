---
import Layout from '../layouts/Layout.astro';
import AboutIntro from '../components/AboutIntro.astro';
import Story from '../components/Story.astro';
import Pillars from '../components/Pillars.astro';
import TeamGrid from '../components/TeamGrid.astro';
import EndNote from '../components/EndNote.astro';
---

<Layout
  title="Tentang pengabdian | Banyubiru"
  description="Enam program studi FTI bekerja di Desa Kebondowo, Kecamatan Banyubiru: jalan, energi surya, olahan pangan, dan digitalisasi usaha warga."
>
  <AboutIntro />
  <Story />
  <Pillars />
  <TeamGrid />
  <EndNote
    date="Catatan lapangan"
    title="Baca apa yang dikerjakan, bukan hanya niatnya."
    body="Setiap program kerja punya lokasi, penanggung jawab, dan daftar luaran. Semuanya bisa diperiksa satu per satu."
    href="/proker"
    linkLabel="Lihat program kerja"
  />
</Layout>