---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
---

<Layout
  title="Galeri & Dokumentasi | Sistem Informasi Pengmas FTI Banyubiru"
  description="Rekam jejak visual 14 hari pengabdian masyarakat FTI di Banyubiru: infrastruktur, pangan, digitalisasi, dan panggung Gelar Karya."
  type="website"
>
  <section class="relative overflow-hidden bg-slate-50">
    <div class="pointer-events-none absolute -left-24 -top-24 h-80 w-80 rounded-full bg-brand-50 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full bg-brand-100/60 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          Galeri &amp; Dokumentasi
        </span>
        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl lg:text-5xl">
          Lensa Pengabdian Banyubiru
        </h1>
        <p class="mt-5 text-base leading-relaxed text-slate-600 md:text-lg">
          Rekam jejak visual 14 hari kolaborasi mahasiswa dan warga — dari
          cor-coran di jalan desa, aroma olahan pangan, hingga lampu panggung
          yang menyala di puncak Gelar Karya.
        </p>
      </div>

      <div class="mt-14">
        <GalleryGrid />
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-8 rounded-[2rem] bg-slate-900 p-10 text-center md:flex-row md:text-left lg:p-14">
        <div>
          <h2 class="text-2xl font-extrabold tracking-tight text-white md:text-3xl">
            Setiap Foto Menyimpan Cerita
          </h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-300 md:text-base">
            Baca narasi lengkap di balik setiap aksi di lapangan, atau jelajahi
            enam program kerja yang menggerakkan semuanya.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center justify-center gap-4">
          <a
            href="/berita"
            class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-8 py-4 font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-lg"
          >
            Baca Artikel Lengkap
          </a>
          <a
            href="/proker"
            class="inline-flex items-center gap-2 rounded-full border border-white/30 px-8 py-4 font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-white/10 hover:border-white"
          >
            Lihat Program Kerja
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>