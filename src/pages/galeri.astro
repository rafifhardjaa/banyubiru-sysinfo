---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import EndNote from '../components/EndNote.astro';
---

<Layout
  title="Galeri lapangan | Banyubiru"
  description="Dokumentasi visual pengabdian FTI di Desa Kebondowo: infrastruktur, olahan pangan, digitalisasi, sosialisasi, dan Gelar Karya."
>
  <section class="wrap pt-6 sm:pt-8">
    <h1 class="mt-4 max-w-[18ch] text-[clamp(2.4rem,4.4vw,4.25rem)]">
      Yang tersisa setelah panggung dibongkar.
    </h1>
    <p class="lede mt-6">
      Dokumentasi per kategori kegiatan. Foto pada halaman ini masih berupa
      ilustrasi dan akan diganti dengan hasil pemotretan tim di lapangan.
    </p>
  </section>

  <section class="wrap mt-section-s">
    <GalleryGrid />
  </section>

  <EndNote
    date="Baca kronologinya"
    title="Setiap foto punya catatan di baliknya."
    body="Laporan lengkap tiap kegiatan, termasuk kendala dan hasil yang belum tuntas, ada di halaman catatan."
    href="/berita"
    linkLabel="Baca catatan lapangan"
  />
</Layout>