---
import Layout from '../../layouts/Layout.astro';
import ProkerRow from '../../components/ProkerRow.astro';
import { getCollection } from 'astro:content';

const proker = (await getCollection('proker')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Program kerja | Banyubiru"
  description="Enam program kerja Fakultas Teknologi Informasi di Desa Kebondowo: energi surya, pengecoran jalan, olahan pangan, tata ruang, dan digitalisasi UMKM."
>
  <section class="wrap pt-10 sm:pt-14">
    <h1 class="mt-4 max-w-[18ch] font-display text-[clamp(2.4rem,5.5vw,4.2rem)] font-semibold leading-[1] tracking-tightest">
      Enam pekerjaan, enam prodi, satu desa.
    </h1>
    <p class="lede mt-6">
      Setiap program berasal dari kebutuhan yang disepakati bersama warga.
      Buka satu untuk melihat lokasi, penanggung jawab, dan luaran yang
      dijanjikan.
    </p>
  </section>

  <section class="wrap mt-12">
    {proker.map((item, index) => (
      <ProkerRow item={item} index={index} flip={index % 2 === 1} />
    ))}
  </section>
</Layout>
