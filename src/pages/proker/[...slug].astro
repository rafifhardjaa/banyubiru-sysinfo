---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Figure from '../../components/Figure.astro';
import { prokerPhoto } from '../../lib/prokerPhoto';

export async function getStaticPaths() {
  const entries = await getCollection('proker');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

const shareText = encodeURIComponent(`${entry.data.title} ${Astro.url.href}`);
---

<Layout title={entry.data.title} description={entry.data.ringkasan} type="article">
  <article class="wrap pt-8 sm:pt-10">
    <nav class="text-sm text-ink-mute" aria-label="Remah roti">
      <a href="/proker" class="underline decoration-line underline-offset-4 hover:text-ink">
        Program kerja
      </a>
      <span class="px-2" aria-hidden="true">/</span>
      <span class="text-ink-soft">{entry.data.prodi}</span>
    </nav>

    <header class="mt-8 max-w-4xl">
      <p class="label">{formatDate(entry.data.publishDate)}</p>
      <h1 class="mt-3 font-display text-[clamp(2.1rem,4.8vw,3.6rem)] font-semibold leading-[1.03] tracking-tightest">
        {entry.data.title}
      </h1>
      <p class="lede mt-5">{entry.data.ringkasan}</p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 border-t border-line pt-5 text-sm">
        <div class="flex gap-2">
          <dt class="text-ink-mute">Prodi</dt>
          <dd class="font-semibold text-ink">{entry.data.prodi}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-ink-mute">Lokasi</dt>
          <dd class="font-semibold text-ink">{entry.data.lokasi}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-ink-mute">Status</dt>
          <dd class:list={['font-semibold', entry.data.progressPercent >= 100 ? 'text-danau' : 'text-ink']}>
            {entry.data.status} · {entry.data.progressPercent}%
          </dd>
        </div>
      </dl>
    </header>

    <div class="mt-10">
      <Figure
        src={prokerPhoto(entry.data.kategori)}
        alt={`Ilustrasi untuk program ${entry.data.prodi}`}
        ratio="aspect-[16/10]"
        caption="Foto ilustrasi. Dokumentasi kegiatan menyusul."
        priority
      />
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <div class="prose-editorial">
          <Content />
        </div>

        <div class="mt-14 border-t border-line pt-6">
          <p class="text-sm leading-relaxed text-ink-soft">
            <span class="font-semibold text-ink">Tentang penulis.</span>
            Divisi Media &amp; IT FTI menulis dan menyunting catatan lapangan
            pengabdian di Desa Kebondowo.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line pt-6">
          <span class="text-sm text-ink-mute">Bagikan</span>
          <a
            href={`https://wa.me/?text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-line min-h-[44px] px-4 py-2"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-line min-h-[44px] px-4 py-2"
          >
            X / Twitter
          </a>
          <a href="/proker" class="link-more ml-auto">Kembali ke katalog program kerja</a>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="top-24 space-y-6 lg:sticky">
          <div class="border border-line bg-paper-light p-6">
            <h2 class="text-sm font-semibold text-ink">Ringkas</h2>
            <dl class="mt-3 divide-y divide-line text-sm">
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Kategori</dt>
                <dd class="text-right font-semibold text-ink">{entry.data.kategori}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Lokasi</dt>
                <dd class="text-right font-semibold text-ink">{entry.data.lokasi}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-mute">Status</dt>
                <dd class="text-right font-semibold text-ink">{entry.data.status} · {entry.data.progressPercent}%</dd>
              </div>
            </dl>
          </div>

          <div class="border border-line bg-paper-light p-6">
            <h2 class="text-sm font-semibold text-ink">Penanggung jawab</h2>
            <p class="mt-2 text-base text-ink-soft">{entry.data.leadProdi}</p>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>