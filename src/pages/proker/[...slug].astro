---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveProkerImage } from '../../lib/prokerAssets';

export async function getStaticPaths() {
  const entries = await getCollection('proker');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const isDone = entry.data.progressPercent >= 100;
const statusStyle = isDone
  ? 'bg-emerald-500/90 text-white'
  : 'bg-amber-500/90 text-white';
---

<Layout title={`${entry.data.title} | Program Kerja FTI Banyubiru`}>
  <section class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a
        href="/proker"
        class="inline-flex items-center gap-2 text-sm font-bold text-brand-700 transition-colors hover:text-brand-800"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Kembali ke Katalog Proker
      </a>

      <div class="mt-8 overflow-hidden rounded-[2rem] bg-white shadow-sm">
        <div class="relative aspect-[16/9] overflow-hidden">
          <Image
            src={resolveProkerImage(entry.data.image)}
            alt={`Program ${entry.data.prodi}: ${entry.data.title}`}
            width={1280}
            height={720}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-[340px,1fr] lg:p-14">
          <aside class="lg:sticky lg:top-24 lg:self-start">
            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-brand-700 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-white">
                  {entry.data.prodi}
                </span>
                <span class={`inline-flex items-center rounded-full px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest ${statusStyle}`}>
                  {entry.data.status}
                </span>
              </div>

              <div class="mt-6">
                <div class="flex items-center justify-between text-xs font-bold">
                  <span class="text-slate-500">Progres Pengerjaan</span>
                  <span class="text-brand-700">{entry.data.progressPercent}%</span>
                </div>
                <div class="mt-2 h-3 overflow-hidden rounded-full bg-slate-200">
                  <div
                    class="h-full rounded-full bg-brand-600"
                    style={`width: ${entry.data.progressPercent}%`}
                  ></div>
                </div>
              </div>

              <dl class="mt-6 space-y-4 text-sm">
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <div>
                    <dt class="text-xs font-bold uppercase tracking-widest text-slate-400">Lokasi</dt>
                    <dd class="mt-1 font-semibold text-slate-700">{entry.data.lokasi}</dd>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  <div>
                    <dt class="text-xs font-bold uppercase tracking-widest text-slate-400">Penanggung Jawab</dt>
                    <dd class="mt-1 font-semibold text-slate-700">{entry.data.leadProdi}</dd>
                  </div>
                </div>
              </dl>
            </div>

            <div class="mt-6 rounded-2xl border border-brand-100 bg-brand-50 p-6">
              <h2 class="text-sm font-extrabold uppercase tracking-widest text-brand-700">
                Target Luaran (Output Kunci)
              </h2>
              <ul class="mt-4 space-y-3">
                {entry.data.targetLuaran.map((output) => (
                  <li class="flex items-start gap-3 text-sm font-medium text-slate-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    {output}
                  </li>
                ))}
              </ul>
            </div>
          </aside>

          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-slate-400">
              {entry.data.kategori}
            </span>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">
              {entry.data.title}
            </h1>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              {entry.data.ringkasan}
            </p>

            <article class="prose prose-slate mt-8 max-w-none prose-teal lg:prose-lg">
              <Content />
            </article>

            <div class="mt-10 flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="mt-10 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-8">
              <a
                href="/proker"
                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-bold text-brand-700 transition-all hover:-translate-y-0.5 hover:border-brand-100 hover:bg-brand-50 hover:shadow-md"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Kembali ke Katalog Proker
              </a>
              <a
                href="/kontak"
                class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-6 py-3.5 text-sm font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-lg"
              >
                Hubungi Penanggung Jawab via Aspirasi
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                  <path d="m22 2-7 20-4-9-9-4Z"></path>
                  <path d="M22 2 11 13"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>