---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stories from '../components/Stories.astro';
import Facts from '../components/Facts.astro';
import Journey from '../components/Journey.astro';
import ProkerIndex from '../components/ProkerIndex.astro';
import PullQuote from '../components/PullQuote.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import EndNote from '../components/EndNote.astro';
---

<Layout>
  <Hero />
  <Stories />
  <Facts />
  <Journey />
  <ProkerIndex />
  <PullQuote
    quote="Ilmu tidaklah bermakna jika tak pernah menapaki tanah desa. Di Banyubiru kami belajar sambil membangun, mengabdi sambil mencipta."
    attribution="Divisi Pengabdian Masyarakat FTI"
  />
  <PhotoStrip />
  <EndNote
    date="Gelar karya · 25 Agustus 2026"
    title="Pameran selesai. Dokumentasinya ada di galeri."
    body="Foto, luaran program, dan catatan ada di galeri. Untuk kerja sama, hubungi posko."
    href="/galeri"
    linkLabel="Buka galeri"
  />
</Layout>
