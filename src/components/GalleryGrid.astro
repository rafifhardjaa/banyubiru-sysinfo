---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const galeriImages = import.meta.glob('../assets/galeri/*.svg', {
  eager: true,
  import: 'default',
}) as Record<string, string>;

const galeri = (await getCollection('galeri')).sort(
  (a, b) => a.data.order - b.data.order,
);

function resolveImage(id: string): string {
  return galeriImages[`../assets/galeri/${id}.svg`] ?? Object.values(galeriImages)[0];
}

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<ul class="columns-1 gap-6 sm:columns-2 lg:columns-3">
  {galeri.map((item) => (
    <li class="mb-6 break-inside-avoid reveal-on-scroll">
      <figure class="group relative overflow-hidden rounded-[2rem] shadow-sm ring-1 ring-slate-100">
        <Image
          src={resolveImage(item.id)}
          alt={item.data.title}
          width={item.data.aspect === 'portrait' ? 800 : 1200}
          height={item.data.aspect === 'portrait' ? 900 : 675}
          class:list={[
            'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105',
            item.data.aspect === 'portrait' ? 'aspect-[4/5]' : 'aspect-[16/9]',
          ]}
          loading="lazy"
          decoding="async"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          aria-hidden="true"
        ></div>

        <figcaption
          class="absolute inset-x-0 bottom-0 translate-y-4 p-6 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <span class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white ring-1 ring-white/25 backdrop-blur-md">
            {item.data.category}
          </span>
          <h3 class="mt-3 text-lg font-bold leading-snug tracking-tight text-white">
            {item.data.title}
          </h3>
          <time class="mt-1 block text-xs font-semibold text-slate-300" datetime={item.data.date.toISOString()}>
            {formatDate(item.data.date)}
          </time>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>