---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { photos } from '../lib/photos';

const galeri = (await getCollection('galeri')).sort(
  (a, b) => a.data.order - b.data.order,
);

const byCategory: Record<string, keyof typeof photos> = {
  Infrastruktur: 'jalan',
  'Inovasi Pangan': 'pangan',
  'Digitalisasi & IoT': 'digital',
  'Gelar Karya': 'senja',
  Sosialisasi: 'mahasiswa',
};

/** Foto per entri, supaya dua kegiatan berkategori sama tidak tampil dengan gambar identik. */
const bySlug: Record<string, keyof typeof photos> = {
  'pengecoran-jalan': 'jalan',
  'pju-tenaga-surya': 'surya',
  'pengolahan-pangan': 'pangan',
  'digital-marketing': 'digital',
  'literasi-digital': 'mahasiswa',
  'persiapan-expo': 'senja',
};

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<ul class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  {galeri.map((item, index) => (
    <li>
      <figure class="flex h-full flex-col">
        <div class="aspect-[4/3] overflow-hidden border border-ink/20 bg-paper-light">
          <Picture
            src={photos[bySlug[item.id] ?? byCategory[item.data.category] ?? 'sawah']}
            alt={`Ilustrasi untuk kategori ${item.data.category}`}
            width={1200}
            height={900}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="h-full w-full object-cover"
            loading={index < 2 ? 'eager' : 'lazy'}
            fetchpriority={index < 2 ? 'high' : undefined}
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 flex flex-1 flex-col border-t border-ink/20 pt-3">
          <p class="text-xs text-ink">{item.data.category}</p>
          <h3 class="mt-1.5 text-lg leading-snug tracking-tight">
            {item.data.title}
          </h3>
          <time
            class="mt-auto block pt-2 text-xs text-ink-mute"
            datetime={item.data.date.toISOString()}
          >
            {formatDate(item.data.date)}
          </time>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>
