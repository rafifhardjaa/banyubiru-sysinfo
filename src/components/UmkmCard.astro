---
import type { CollectionEntry } from 'astro:content';
import Figure from './Figure.astro';
import { photos } from '../lib/photos';

interface Props {
  umkm: CollectionEntry<'umkm'>;
  index: number;
  flip?: boolean;
}

const { umkm, index, flip = false } = Astro.props;

const byCategory: Record<string, keyof typeof photos> = {
  'Pangan Olahan': 'pangan',
  Kerajinan: 'kerajinan',
  'Minuman Tradisional': 'tani',
};

const photo = photos[byCategory[umkm.data.category] ?? 'pasar'];
---

<article class="grid gap-6 border-t border-line py-8 lg:grid-cols-12 lg:items-center lg:gap-10">
  <div class:list={['lg:col-span-5', flip ? 'lg:order-2' : '']}>
    <Figure
      src={photo}
      alt={`Ilustrasi untuk usaha ${umkm.data.category}`}
      ratio="aspect-[4/3]"
      sizes="(min-width: 1024px) 40vw, 100vw"
    />
  </div>

  <div class:list={['lg:col-span-7', flip ? 'lg:order-1' : '']}>
    <p class="label">
      {String(index + 1).padStart(2, '0')} · {umkm.data.category} · {umkm.data.hamlet}
    </p>
    <h3 class="mt-2 text-2xl leading-[1.15] sm:text-3xl">{umkm.data.name}</h3>
    <p class="mt-1 text-sm text-ink-mute">Dikelola {umkm.data.owner}</p>
    <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-ink-soft">
      {umkm.data.description}
    </p>
    <p class="mt-4 text-sm font-semibold text-ink">{umkm.data.price}</p>

    <a
      href={umkm.data.waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-solid mt-5"
    >
      Hubungi via WhatsApp
      <span class="sr-only">(membuka tab baru)</span>
    </a>
  </div>
</article>