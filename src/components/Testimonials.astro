---
const testimonials = [
  {
    name: 'Bapak Supriyadi',
    role: 'Kepala Desa / Tokoh Masyarakat',
    quote:
      'Akses jalan yang dulu sulit kini mulus dan penerangan desa semakin terang. Semangat adik-adik mahasiswa benar-benar menyentuh kebutuhan warga.',
    initials: 'S',
    accent: 'bg-brand-600',
  },
  {
    name: 'Ibu Wahyuni',
    role: 'Penggiat UMKM Lokal',
    quote:
      'Olahan pangan kami sekarang lebih rapi, higienis, dan laku lebih mahal. Pendampingan mahasiswa Teknologi Pangan membuka jalan usaha baru bagi kami.',
    initials: 'W',
    accent: 'bg-brand-500',
  },
  {
    name: 'Dimas Prasetyo',
    role: 'Ketua Karang Taruna',
    quote:
      'Kolaborasi pemuda desa dengan mahasiswa Informatika terasa hidup. Digitalisasi usaha kecil membuat anak muda semakin percaya diri berkreasi.',
    initials: 'D',
    accent: 'bg-brand-700',
  },
];
---

<section class="bg-slate-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
        Suara & Harapan Warga
      </span>
      <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl lg:text-4xl">
        Warga Bercerita, Kami Mendengar
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        Dampak pengabdian paling jujur datang dari mereka yang merasakan
        langsung perubahan di desa.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((item) => (
        <li class="flex flex-col rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
          <span class="text-5xl font-black leading-none text-brand-500" aria-hidden="true">
            &ldquo;
          </span>
          <blockquote class="mt-2 flex-1 text-base leading-relaxed text-slate-600">
            {item.quote}
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-6">
            <span
              class:list={[
                'flex h-12 w-12 items-center justify-center rounded-full text-lg font-extrabold text-white',
                item.accent,
              ]}
              aria-hidden="true"
            >
              {item.initials}
            </span>
            <div>
              <p class="text-sm font-bold text-slate-900">{item.name}</p>
              <p class="text-xs font-semibold text-slate-500">{item.role}</p>
            </div>
          </figcaption>
        </li>
      ))}
    </ul>
  </div>
</section>