---
const targetTimestamp = new Date('2026-10-25T09:00:00+07:00').getTime();
---

<div
  id="expo-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-3 backdrop-blur-md transition-all duration-300 sm:p-4 md:p-6"
>
  <div
    class="relative flex w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-slate-700/60 bg-slate-900 text-white shadow-2xl md:rounded-3xl"
    style="max-height: 88vh;"
  >
    <div class="pointer-events-none absolute -left-20 -top-20 h-48 w-48 rounded-full bg-teal-500/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -right-20 h-48 w-48 rounded-full bg-teal-700/10 blur-3xl"></div>

    <div class="flex shrink-0 items-center justify-between border-b border-slate-800 p-4 md:p-6">
      <div>
        <span
          class="inline-flex items-center rounded-full border border-teal-900/60 bg-teal-950/60 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-teal-400 md:text-xs"
        >
          Puncak Pengabdian
        </span>
        <h2 class="mt-2 text-lg font-extrabold tracking-tight text-white md:mt-3 md:text-xl">
          Expo Gelar Karya FTI Banyubiru
        </h2>
      </div>
      <button
        id="btn-close-expo"
        type="button"
        class="rounded-full bg-slate-800/80 p-2 text-slate-300 transition-colors hover:bg-slate-700 hover:text-white"
        aria-label="Tutup modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="overflow-y-auto overscroll-contain p-4 md:p-6" style="max-height: calc(88vh - 120px);">
      <div data-countdown={targetTimestamp}>
        <div class="grid grid-cols-4 gap-2 md:gap-3" data-countdown-boxes>
          <div class="rounded-xl border border-white/5 bg-slate-800/60 p-2 text-center md:p-3">
            <p data-countdown-unit="hari" class="text-xl font-black tabular-nums text-teal-400 md:text-3xl">00</p>
            <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 md:text-xs">Hari</p>
          </div>
          <div class="rounded-xl border border-white/5 bg-slate-800/60 p-2 text-center md:p-3">
            <p data-countdown-unit="jam" class="text-xl font-black tabular-nums text-teal-400 md:text-3xl">00</p>
            <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 md:text-xs">Jam</p>
          </div>
          <div class="rounded-xl border border-white/5 bg-slate-800/60 p-2 text-center md:p-3">
            <p data-countdown-unit="menit" class="text-xl font-black tabular-nums text-teal-400 md:text-3xl">00</p>
            <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 md:text-xs">Menit</p>
          </div>
          <div class="rounded-xl border border-white/5 bg-slate-800/60 p-2 text-center md:p-3">
            <p data-countdown-unit="detik" class="text-xl font-black tabular-nums text-teal-400 md:text-3xl">00</p>
            <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 md:text-xs">Detik</p>
          </div>
        </div>
        <p
          class="hidden rounded-xl border border-teal-900/60 bg-teal-950/60 p-4 text-center text-base font-extrabold text-teal-400 md:text-lg"
          data-countdown-finished
        >
          Pameran Expo Sedang Berlangsung!
        </p>
      </div>

      <div class="mt-4 space-y-3 md:mt-6 md:space-y-4">
        <div class="flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-800/40 p-3 md:gap-4 md:p-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-950/60 text-sm md:h-10 md:w-10 md:text-base">📍</span>
          <div>
            <p class="text-xs font-bold text-white md:text-sm">Lokasi</p>
            <p class="mt-0.5 text-xs leading-relaxed text-slate-400 md:text-sm">Lapangan Utama / Balai Desa Banyubiru, Kecamatan Banyubiru, Kabupaten Semarang</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-800/40 p-3 md:gap-4 md:p-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-950/60 text-sm md:h-10 md:w-10 md:text-base">⏰</span>
          <div>
            <p class="text-xs font-bold text-white md:text-sm">Waktu</p>
            <p class="mt-0.5 text-xs leading-relaxed text-slate-400 md:text-sm">Selasa, 25 Oktober 2026 — Pukul 09.00 WIB sampai selesai</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-800 bg-slate-800/40 p-3 md:gap-4 md:p-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-950/60 text-sm md:h-10 md:w-10 md:text-base">🎪</span>
          <div>
            <p class="text-xs font-bold text-white md:text-sm">Agenda & Rangkaian Acara</p>
            <ul class="mt-1.5 space-y-1 text-xs leading-relaxed text-slate-400 md:mt-2 md:space-y-1.5 md:text-sm">
              <li class="flex items-center gap-2">
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                Demo Teknologi & Inovasi 6 Program Studi FTI
              </li>
              <li class="flex items-center gap-2">
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                Pameran Produk Unggulan UMKM Binaan Warga
              </li>
              <li class="flex items-center gap-2">
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                Talkshow Inspiratif & Pentas Seni Budaya
              </li>
              <li class="flex items-center gap-2">
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                Penandatanganan Komitmen Keberlanjutan Program
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 gap-2 border-t border-slate-800 bg-slate-900/90 p-4">
      <button
        id="btn-close-expo-bottom"
        type="button"
        class="w-full rounded-xl bg-slate-800 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 sm:w-auto"
      >
        Tutup
      </button>
    </div>
  </div>
</div>

<script>
  function initExpoModal() {
    const modal = document.getElementById('expo-modal');
    const btnOpen = document.getElementById('btn-open-expo');
    const btnClose = document.getElementById('btn-close-expo');
    const btnCloseBottom = document.getElementById('btn-close-expo-bottom');

    if (!modal || !btnOpen) return;
    if (modal.dataset.modalReady) return;
    modal.dataset.modalReady = 'true';

    function open() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      startCountdown();
    }

    function close() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    btnOpen.addEventListener('click', open);

    if (btnClose) btnClose.addEventListener('click', close);
    if (btnCloseBottom) btnCloseBottom.addEventListener('click', close);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });

    let countdownTimer = null;

    function startCountdown() {
      if (countdownTimer) return;
      const root = modal.querySelector('[data-countdown]');
      if (!root) return;
      const target = Number(root.dataset.countdown || 0);
      const boxes = root.querySelector('[data-countdown-boxes]');
      const finished = root.querySelector('[data-countdown-finished]');
      const units = root.querySelectorAll('[data-countdown-unit]');

      const pad = (n) => String(Math.max(0, n)).padStart(2, '0');

      function tick() {
        const diff = Math.max(0, target - Date.now());

        if (diff === 0) {
          if (boxes) boxes.classList.add('hidden');
          if (finished) finished.classList.remove('hidden');
          if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
          return;
        }

        const values = [
          Math.floor(diff / 86_400_000),
          Math.floor((diff % 86_400_000) / 3_600_000),
          Math.floor((diff % 3_600_000) / 60_000),
          Math.floor((diff % 60_000) / 1_000),
        ];

        units.forEach((unit, index) => {
          unit.textContent = pad(values[index]);
        });
      }

      tick();
      countdownTimer = setInterval(tick, 1000);
    }
  }

  document.addEventListener('astro:page-load', initExpoModal);
  if (document.readyState !== 'loading') initExpoModal();
</script>