---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const beritaImages = import.meta.glob('../assets/berita/*.svg', {
  eager: true,
  import: 'default',
}) as Record<string, string>;

const berita = (await getCollection('berita'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

function resolveImage(id: string): string {
  return beritaImages[`../assets/berita/${id}.svg`] ?? Object.values(beritaImages)[0];
}

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
          Kabar Pengabdian
        </span>
        <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl lg:text-4xl">
          Cerita Terbaru dari Lapangan
        </h2>
      </div>
      <a
        href="/berita"
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-brand-700 transition-all hover:-translate-y-0.5 hover:border-brand-100 hover:bg-brand-50 hover:shadow-md"
      >
        Lihat Semua Berita
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {berita.map((item) => (
        <li class="group flex flex-col overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md reveal-on-scroll">
          <a href={`/berita/${item.id}`} class="block">
            <div class="relative aspect-[16/10] overflow-hidden">
              <Image
                src={resolveImage(item.id)}
                alt={item.data.title}
                width={800}
                height={500}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-widest text-brand-700">
                {item.data.category}
              </span>
              <time class="text-xs font-semibold text-slate-400" datetime={item.data.publishDate.toISOString()}>
                {formatDate(item.data.publishDate)}
              </time>
            </div>
            <h3 class="mt-4 text-lg font-bold leading-snug tracking-tight text-slate-900 transition-colors group-hover:text-brand-700 md:text-xl">
              <a href={`/berita/${item.id}`}>{item.data.title}</a>
            </h3>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 md:line-clamp-3">
              {item.data.summary}
            </p>
            <div class="mt-auto pt-5">
              <a
                href={`/berita/${item.id}`}
                class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 transition-colors hover:text-brand-800"
              >
                Baca Selengkapnya
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>