---
import { Image } from 'astro:assets';
import aboutVisual from '../assets/about/banyubiru-about.svg';
import potensi from '../assets/hero/potensi.svg';

const highlights = [
  'Kecamatan di selatan Kabupaten Semarang',
  'Diapit Rawa Pening dan perbukitan hijau',
  'Komoditas agraris & UMKM yang tumbuh',
  'Ruang belajar pengabdian lintas prodi',
];
---

<section class="relative overflow-hidden bg-slate-50">
  <div class="pointer-events-none absolute -left-24 -top-24 h-80 w-80 rounded-full bg-brand-50 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full bg-brand-100/60 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-4 pb-24 pt-16 sm:px-6 lg:grid-cols-2 lg:px-8 lg:pb-32 lg:pt-24">
    <div class="relative z-10">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Tentang Kami
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-5xl">
        Di Banyubiru, Ilmu Menapak Tanah dan Menyentuh Manusia
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-600 md:text-lg">
        Portal ini adalah rekam jejak pengabdian masyarakat Fakultas Teknologi
        Informasi — tempat enam program studi bergerak bersama warga, dari
        membangun infrastruktur hingga menghidupkan potensi lokal.
      </p>

      <ul class="mt-8 space-y-3">
        {highlights.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="text-sm font-semibold text-slate-600 md:text-base">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative px-2 pb-10 pt-2 lg:pb-0">
      <Image
        src={aboutVisual}
        alt="Komposisi visual lanskap dan kehidupan Banyubiru"
        width={800}
        height={900}
        class="h-full w-full rounded-[2.5rem] object-cover shadow-2xl ring-1 ring-slate-100"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <Image
        src={potensi}
        alt="Potensi UMKM dan komoditas lokal Banyubiru"
        width={500}
        height={500}
        class="absolute -bottom-6 -left-6 w-40 -rotate-6 rounded-3xl object-cover shadow-xl ring-4 ring-white sm:-left-10 sm:w-52"
        loading="eager"
        decoding="async"
      />
      <div class="absolute -top-6 right-6 rounded-2xl bg-white/90 px-5 py-4 shadow-lg backdrop-blur-md ring-1 ring-slate-100">
        <p class="text-2xl font-extrabold text-brand-700">Sejak 2026</p>
        <p class="text-xs font-semibold text-slate-500">Awal Jejak Pengabdian</p>
      </div>
    </div>
  </div>
</section>