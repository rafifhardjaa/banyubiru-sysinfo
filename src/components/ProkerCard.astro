---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { resolveProkerImage } from '../lib/prokerAssets';

interface Props {
  item: CollectionEntry<'proker'>;
}

const { item } = Astro.props;

const isDone = item.data.progressPercent >= 100;
const statusStyle = isDone
  ? 'bg-emerald-500/90 text-white'
  : 'bg-amber-500/90 text-white';
---

<li class="group flex flex-col overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md reveal-on-scroll">
  <a href={`/proker/${item.id}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={resolveProkerImage(item.data.image)}
        alt={`Program ${item.data.prodi}: ${item.data.title}`}
        width={800}
        height={600}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
      <span class="inline-block rounded-full border border-teal-200 bg-teal-50 px-2.5 py-1 text-xs font-semibold text-brand-700">
        {item.data.prodi}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
        {item.data.status}
      </span>
    </div>
    <h3 class="mt-1 line-clamp-2 text-lg font-bold tracking-tight text-slate-900 md:text-xl">
      <a href={`/proker/${item.id}`} class="transition-colors group-hover:text-brand-700">
        {item.data.title}
      </a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">
      {item.data.ringkasan}
    </p>
    <div class="mt-4">
      <div class="flex items-center justify-between text-xs font-bold">
        <span class="text-slate-400">Progres Pengerjaan</span>
        <span class="text-brand-700">{item.data.progressPercent}%</span>
      </div>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
        <div
          class="h-full rounded-full bg-brand-600 transition-all"
          style={`width: ${item.data.progressPercent}%`}
        ></div>
      </div>
    </div>
    <div class="mt-auto pt-5">
      <a
        href={`/proker/${item.id}`}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 transition-colors hover:text-brand-800"
      >
        Lihat Detail Program Kerja
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</li>