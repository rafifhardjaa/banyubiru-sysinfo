---
import SurveyMap from './SurveyMap.astro';
---

<section class="wrap pt-6 sm:pt-8">
  <div class="grid gap-x-10 gap-y-10 border-t border-ink/30 pt-8 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <h1 class="max-w-[13ch] text-[clamp(2.4rem,4.4vw,4.25rem)] font-semibold leading-[1.03] tracking-tightest">
        Enam prodi. Satu desa.
      </h1>

      <p class="lede mt-5 max-w-[40ch]">
        Jejak FTI di Kebondowo: jalan, surya, pangan, digital.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/berita" class="btn-solid">Baca catatan</a>
        <a href="/proker" class="btn-line">Lihat proker</a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <SurveyMap class="lg:-mr-2" />
    </div>
  </div>
</section>
