---
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const proker = (await getCollection('proker')).sort((a, b) => a.data.order - b.data.order);

// Survey coordinates are drawn from the location named in each record, not
// from a navigation source: the map is a diagram of the programme, schematic.
const points: Record<string, { x: number; y: number; label: string }> = {
  'mesin-solar-cell': { x: 208, y: 206, label: 'Dusun Krajan' },
  'sipil-pengecoran-jalan': { x: 512, y: 398, label: 'Dusun Rowoboni' },
  'elektro-smart-pju': { x: 430, y: 246, label: 'Jalan poros desa' },
  'arsitektur-maket-desa': { x: 322, y: 322, label: 'Seluruh dusun' },
  'pangan-inovasi-wader': { x: 236, y: 424, label: 'Kelompok UMKM pangan' },
  'informatika-smart-umkm': { x: 342, y: 466, label: 'Kantor desa' },
};

const pins = proker.map((entry, index) => ({
  n: String(index + 1).padStart(2, '0'),
  title: entry.data.title,
  ...points[entry.id],
}));
---

<figure class:list={['survey', className]}>
  <div class="survey-sheet entry">
    <svg
      viewBox="0 0 720 600"
      role="img"
      aria-labelledby="survey-title survey-desc"
      class="block h-auto w-full"
    >
      <title id="survey-title">Peta survei program kerja di Desa Kebondowo</title>
      <desc id="survey-desc">
        Peta skematis desa dengan enam titik program: solar cell di Dusun Krajan, pengecoran jalan di Dusun
        Rowoboni, penerangan jalan di jalan poros, maket tata ruang, olahan pangan, dan sistem informasi desa.
      </desc>

      <defs>
        <clipPath id="survey-holding">
          <path d="M 96 150 L 268 96 L 452 104 L 548 148 L 606 250 L 636 372 L 604 470 L 448 540 L 268 522 L 152 470 L 92 344 Z" />
        </clipPath>
        <pattern id="survey-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="var(--color-contour)" stroke-width="0.6" opacity="0.5" />
        </pattern>
      </defs>

      <rect width="720" height="600" fill="var(--color-paper)" />

      <!-- Water: Rawa Pening to the north east, outside the holding. -->
      <path
        d="M 556 0 H 720 V 210 C 690 196 664 174 646 148 C 618 108 584 62 556 0 Z"
        fill="var(--color-water)"
        opacity="0.18"
      />
      <path
        d="M 556 0 H 720 V 210 C 690 196 664 174 646 148 C 618 108 584 62 556 0 Z"
        fill="none"
        stroke="var(--color-water)"
        stroke-width="1.2"
        opacity="0.55"
      />
      <g stroke="var(--color-water)" stroke-width="0.9" opacity="0.45" fill="none">
        <path d="M 610 62 q 26 -10 52 0" />
        <path d="M 632 96 q 26 -10 52 0" />
        <path d="M 616 132 q 30 -12 60 2" />
        <path d="M 648 174 q 24 -8 48 2" />
      </g>

      <g clip-path="url(#survey-holding)">
        <rect
          x="80"
          y="80"
          width="580"
          height="480"
          fill="var(--color-paper-2)"
          opacity="0.65"
        />

        <!-- Contours, three hills, sienna. -->
        <g fill="none" stroke="var(--color-contour)" stroke-width="0.9" opacity="0.55">
          <path d="M 118 300 C 96 236 140 176 214 158 C 292 138 366 172 386 244 C 406 316 356 386 274 398 C 190 410 140 364 118 300 Z" />
          <path d="M 146 300 C 130 248 166 200 226 186 C 290 170 348 198 364 254 C 380 314 340 368 274 378 C 208 388 166 352 146 300 Z" />
          <path d="M 178 300 C 168 262 194 226 240 216 C 288 206 330 228 342 268 C 354 312 322 350 274 356 C 226 362 190 338 178 300 Z" />
          <path d="M 212 302 C 208 278 224 254 254 248 C 286 242 312 256 320 282 C 328 310 308 334 278 338 C 248 342 218 328 212 302 Z" />

          <path d="M 402 470 C 386 424 418 380 472 370 C 528 360 580 392 590 440 C 600 488 566 522 512 526 C 458 530 418 514 402 470 Z" />
          <path d="M 430 468 C 420 436 442 406 480 400 C 520 394 556 416 564 450 C 572 484 548 506 512 510 C 476 514 440 500 430 468 Z" />
          <path d="M 460 464 C 456 444 470 426 494 422 C 520 418 542 432 546 454 C 550 476 536 492 512 494 C 488 496 464 484 460 464 Z" />
        </g>

        <!-- Hedgerows: short dashed runs along field edges. -->
        <g stroke="var(--color-hedge)" stroke-width="2" stroke-linecap="round" opacity="0.6">
          <path d="M 148 202 l 22 -6 M 178 193 l 22 -5 M 208 186 l 22 -5" />
          <path d="M 120 372 l 24 4 M 152 377 l 24 4 M 184 381 l 24 4" />
          <path d="M 402 356 l 6 22 M 410 386 l 6 22 M 418 416 l 6 22" />
          <path d="M 546 258 l 22 8 M 572 268 l 22 8" />
          <path d="M 316 500 l 24 2 M 348 503 l 24 2 M 380 505 l 24 2" />
        </g>

        <!-- Two lanes: the village spine and its branch. -->
        <g fill="none" stroke-linecap="round">
          <path
            d="M 118 522 C 190 470 236 404 288 338 C 340 272 398 206 470 156"
            stroke="var(--color-paper-2)"
            stroke-width="12"
          />
          <path
            d="M 118 522 C 190 470 236 404 288 338 C 340 272 398 206 470 156"
            stroke="var(--color-ink)"
            stroke-width="1.4"
            opacity="0.55"
          />
          <path
            d="M 196 500 C 292 474 372 430 438 356 C 486 302 520 262 552 214"
            stroke="var(--color-paper-2)"
            stroke-width="8"
          />
          <path
            d="M 196 500 C 292 474 372 430 438 356 C 486 302 520 262 552 214"
            stroke="var(--color-ink)"
            stroke-width="1"
            opacity="0.4"
          />
        </g>

        <!-- Building footprints: balai desa and the UMKM kitchen. -->
        <g fill="var(--color-paper-2)" stroke="var(--color-ink)" stroke-width="1" opacity="0.75">
          <rect x="330" y="452" width="26" height="18" />
          <rect x="228" y="410" width="18" height="14" />
        </g>

        <rect
          x="92"
          y="90"
          width="560"
          height="470"
          fill="url(#survey-hatch)"
          opacity="0.12"
        />
      </g>

      <!-- The holding, edged like a title plan. -->
      <path
        d="M 96 150 L 268 96 L 452 104 L 548 148 L 606 250 L 636 372 L 604 470 L 448 540 L 268 522 L 152 470 L 92 344 Z"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="2"
        stroke-linejoin="round"
      />

      <!-- Corner ticks. -->
      <g stroke="var(--color-ink)" stroke-width="1.2">
        <path d="M 96 150 h 18 M 96 150 v 18" />
        <path d="M 548 148 h -18 M 548 148 v -18" />
        <path d="M 92 344 h 18 M 92 344 v -18" />
        <path d="M 604 470 h -18 M 604 470 v 18" />
      </g>

      <!-- North arrow and schematic scale. -->
      <g transform="translate(662 508)">
        <path d="M 0 34 V 0" stroke="var(--color-ink)" stroke-width="1" />
        <path d="M 0 0 l -6 12 h 12 Z" fill="var(--color-ink)" />
        <text x="0" y="50" text-anchor="middle" class="survey-mark">U</text>
      </g>
      <g transform="translate(96 562)">
        <path d="M 0 0 h 40 v 5 h -40 Z" fill="var(--color-ink)" opacity="0.8" />
        <text x="48" y="6" class="survey-mark">skala skematis</text>
      </g>

      <!-- Programme pins: ear-tag squares, numbered in the record order. -->
      {
        pins.map((pin) =>
          pin.x ? (
            <g transform={`translate(${pin.x} ${pin.y})`} class="survey-pin">
              <line x1="0" y1="0" x2="0" y2="16" stroke="var(--color-ink)" stroke-width="1" />
              <rect x="-11" y="-20" width="22" height="20" fill="var(--color-accent)" stroke="var(--color-ink)" stroke-width="1" />
              <text x="0" y="-5.5" text-anchor="middle" class="survey-num">{pin.n}</text>
              <circle cx="0" cy="18" r="2.6" fill="var(--color-ink)" />
              <title>{`${pin.n} ${pin.title}, ${pin.label}`}</title>
            </g>
          ) : null,
        )
      }
    </svg>
  </div>

  <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-xs text-ink-mute">
    <span>Peta survei program, digambar dari lokasi di tiap catatan program.</span>
    <span>Skala skematis, bukan peta navigasi.</span>
  </figcaption>
</figure>

<style>
  .survey-sheet {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    box-shadow: 0 0 0 1px var(--color-ink), var(--shadow-lift);
  }

  .survey-mark {
    fill: var(--color-ink);
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0;
  }

  .survey-num {
    fill: var(--color-ink);
    font-family: var(--font-outlier);
    font-size: 9px;
    font-weight: 500;
  }

  .survey-pin rect {
    transition: transform var(--dur-long) var(--ease-out);
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.survey:hover) .survey-pin rect {
      transform: translateY(-2px);
    }
  }
</style>
