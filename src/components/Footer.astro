---
const prodi = [
  'Teknik Mesin',
  'Teknik Sipil',
  'Teknik Elektro',
  'Teknik Arsitektur',
  'Teknologi Pangan',
  'Teknik Informatika',
];

const quickLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program Kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Berita' },
  { href: '/kontak', label: 'Kontak' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-8 md:pt-16 md:pb-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="text-xl font-extrabold tracking-tight text-white">
          FTI<span class="text-brand-500">Banyubiru</span>.
        </a>
        <p class="mt-4 text-xs md:text-sm text-slate-400 max-w-sm leading-relaxed">
          Portal sistem informasi terpadu dan rekam jejak digital kegiatan
          pengabdian masyarakat Fakultas Teknologi Informasi di Desa Kebondowo,
          Kecamatan Banyubiru, Kabupaten Semarang.
        </p>
        <ul class="hidden md:flex flex-wrap gap-1.5 mt-4">
          {prodi.map((nama) => (
            <li class="rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-300 ring-1 ring-slate-700">
              {nama}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-200">
          Navigasi
        </h3>
        <ul class="mt-4 grid grid-cols-2 gap-y-2 gap-x-4 md:flex md:flex-col md:gap-y-2.5 text-xs md:text-sm">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-semibold transition-colors hover:text-brand-500"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-200">
          Terhubung
        </h3>
        <div class="mt-4 text-xs md:text-sm space-y-1 text-slate-400">
          <p>
            Desa Kebondowo, Kawasan Rawa Pening, Kecamatan Banyubiru, Kabupaten
            Semarang, Jawa Tengah.
          </p>
          <p class="font-semibold text-slate-300">
            Divisi Media &amp; IT FTI
          </p>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] md:text-xs text-slate-500">
      <p class="font-semibold">
        © {year} Pengmas FTI Banyubiru. Seluruh hak cipta dilindungi.
      </p>
      <p class="font-semibold">
        powered by <span class="text-brand-500">Banyubiru</span> {" "}
        <span class="text-brand-500">Desa Maju</span>
      </p>
    </div>
  </div>
</footer>