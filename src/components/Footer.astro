---
const prodi = [
  'Teknik Mesin',
  'Teknik Sipil',
  'Teknik Elektro',
  'Teknik Arsitektur',
  'Teknologi Pangan',
  'Teknik Informatika',
];

const quickLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program Kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Berita' },
  { href: '/kontak', label: 'Kontak' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-900 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="text-xl font-extrabold tracking-tight text-white">
          FTI<span class="text-brand-500">Banyubiru</span>.
        </a>
        <p class="mt-4 max-w-md text-sm leading-relaxed">
          Portal sistem informasi terpadu dan rekam jejak digital kegiatan
          pengabdian masyarakat Fakultas Teknologi Informasi di Kecamatan
          Banyubiru, Kabupaten Semarang.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {prodi.map((nama) => (
            <li class="rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-300 ring-1 ring-slate-700">
              {nama}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-200">
          Navigasi
        </h3>
        <ul class="mt-4 space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-semibold transition-colors hover:text-brand-500"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-200">
          Terhubung
        </h3>
        <p class="mt-4 text-sm leading-relaxed">
          Kawasan Rawa Pening, Kecamatan Banyubiru, Kabupaten Semarang, Jawa
          Tengah.
        </p>
        <p class="mt-3 text-sm font-semibold text-slate-300">
          Divisi Media & IT FTI
        </p>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-8 sm:flex-row">
      <p class="text-xs font-semibold">
        © {year} Pengmas FTI Banyubiru. Seluruh hak cipta dilindungi.
      </p>
      <p class="text-xs font-semibold">
        Dibangun dengan <span class="text-brand-500">Astro</span> &amp;{" "}
        <span class="text-brand-500">Tailwind CSS</span> • Zero-JS
      </p>
    </div>
  </div>
</footer>