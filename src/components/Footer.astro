---
const quickLinks = [
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Catatan' },
  { href: '/kontak', label: 'Kontak' },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink/30 bg-paper-deep">
  <div class="wrap pt-12 sm:pt-16">
    <div class="grid gap-10 border-b border-ink/20 pb-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6">
        <p class="font-display text-[clamp(2.5rem,5vw,4rem)] font-semibold leading-none tracking-tightest text-ink">
          Banyubiru
        </p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-soft">
          Catatan pengabdian FTI di Desa Kebondowo, Banyubiru, Semarang.
          Enam prodi, satu desa.
        </p>
      </div>

      <nav aria-labelledby="footer-nav" class="lg:col-span-3">
        <h2 id="footer-nav" class="label">Halaman</h2>
        <ul class="mt-3 border-t border-ink/20">
          {
            quickLinks.map((link) => (
              <li class="border-b border-ink/10">
                <a
                  href={link.href}
                  class="flex min-h-[40px] items-center text-sm text-ink-2 transition-colors hover:text-ink hover:underline hover:decoration-accent hover:decoration-2 hover:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <h2 class="label">Posko pengabdian</h2>
        <address class="mt-3 space-y-2.5 border-t border-ink/20 pt-3 text-sm not-italic leading-relaxed text-ink-2">
          <p>
            Balai Desa Kebondowo<br />
            Kecamatan Banyubiru, Kabupaten Semarang<br />
            Jawa Tengah
          </p>
          <p>
            <a href="mailto:pengmas.fti@gmail.com" class="link-quiet">pengmas.fti@gmail.com</a>
          </p>
          <p>Divisi Media &amp; IT FTI</p>
        </address>
      </div>
    </div>

    <div class="flex flex-col gap-4 py-6 text-xs text-ink-mute sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Pengmas FTI Banyubiru.</p>
      <p class="max-w-[46ch] sm:text-right">
        Foto ilustrasi dari
        <a href="https://unsplash.com" class="underline decoration-line underline-offset-4 hover:text-ink">
          Unsplash
        </a>
        dan akan diganti dengan dokumentasi lapangan. Peta survei digambar dari
        daftar lokasi program.
      </p>
    </div>
  </div>
</footer>
