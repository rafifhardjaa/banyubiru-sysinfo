---
const stages = [
  {
    phase: '01',
    title: 'Penerjunan',
    description: 'Mahasiswa tinggal bersama warga.',
  },
  {
    phase: '02',
    title: 'Sosialisasi',
    description: 'Kebutuhan disepakati bersama desa.',
  },
  {
    phase: '03',
    title: 'Eksekusi',
    description: 'Jalan, surya, pangan, digitalisasi.',
  },
  {
    phase: '04',
    title: 'Gelar karya',
    description: 'Hasil diarsipkan di portal ini.',
  },
];
---

<section class="wrap-wide mt-section-s">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-24">
        <p class="label flex items-center gap-2.5">
          <span class="h-px w-6 shrink-0 bg-accent" aria-hidden="true" />
          Alur pengabdian
        </p>
        <h2 class="mt-3">Empat tahap, satu perjalanan</h2>
        <p class="mt-4 max-w-[42ch] text-base leading-relaxed text-ink-soft">
          Setiap tahap punya keluaran yang bisa diperiksa.
        </p>
      </div>
    </div>

    <ol class="border-t border-ink/30 lg:col-span-8">
      {
        stages.map((stage) => (
          <li class="group grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 border-b border-line py-5 sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-x-6 sm:py-6">
            <span class="num pt-1 text-sm text-ink-mute transition-colors group-hover:text-ink">
              {stage.phase}
            </span>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="text-xl leading-snug sm:text-2xl">{stage.title}</h3>
              <p class="max-w-[56ch] text-base leading-relaxed text-ink-soft">
                {stage.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>