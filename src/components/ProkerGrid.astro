---
import { getCollection } from 'astro:content';
import ProkerCard from './ProkerCard.astro';

const proker = (await getCollection('proker'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section id="proker" class="scroll-mt-24 bg-slate-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
        Program Kerja Kami
      </span>
      <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl lg:text-4xl">
        Enam Prodi, Satu Arah Mengabdi
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        Masing-masing program studi membawa keahliannya menjadi aksi nyata yang
        saling melengkapi bagi warga Banyubiru.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {proker.map((item) => (
        <ProkerCard item={item} />
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/proker"
        class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-8 py-4 font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-lg"
      >
        Lihat Seluruh Program Kerja 6 Prodi
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>