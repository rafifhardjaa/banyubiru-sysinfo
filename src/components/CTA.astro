---
const expoDate = new Date('2026-08-25T09:00:00+07:00');
const formattedDate = new Intl.DateTimeFormat('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(expoDate);
---

<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-950 text-white p-8 md:p-14 shadow-2xl my-12">
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-indigo-900/40 blur-3xl"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-200 border border-blue-400/30 mb-4">
      Puncak Acara • {formattedDate}
    </span>
    <h2 class="text-2xl md:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4 max-w-2xl mx-auto text-center">
      Rekam Jejak & Dedikasi Nyata di Desa Kebondowo
    </h2>
    <p class="text-blue-100/90 text-sm md:text-base max-w-xl mx-auto text-center mb-8 leading-relaxed">
      Telusuri dokumentasi visual, luaran inovasi teknologi, dan warta kolaborasi enam program studi FTI bersama warga Desa Kebondowo, Kecamatan Banyubiru.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="/galeri"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white text-blue-900 hover:bg-blue-50 font-bold shadow-lg shadow-blue-950/20 transition-all active:scale-95 text-sm md:text-base"
      >
        <span>Dokumentasi & Galeri</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a
        href="/kontak"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-blue-700/50 hover:bg-blue-700 text-white border border-blue-400/30 font-semibold transition-all text-sm md:text-base"
      >
        Hubungi Kami
      </a>
    </div>
  </div>
</section>