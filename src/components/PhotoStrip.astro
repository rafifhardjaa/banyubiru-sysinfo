---
import Figure from './Figure.astro';
import SectionHead from './SectionHead.astro';
import { photos } from '../lib/photos';

const strip = [
  {
    src: photos.pangan,
    alt: 'Ilustrasi semangkuk hidangan berkuah dengan sayur dan telur',
    title: 'Pangan olahan',
    note: 'Abon, jamu, dan olahan eceng gondok dari dapur warga.',
  },
  {
    src: photos.kerajinan,
    alt: 'Ilustrasi perajin sedang mengerjakan produk kerajinan',
    title: 'Kerajinan tangan',
    note: 'Batik dan anyaman yang dikerjakan di rumah, bukan pabrik.',
  },
  {
    src: photos.tani,
    alt: 'Ilustrasi bibit tanaman di dalam pot',
    title: 'Hasil kebun',
    note: 'Kopi dan komoditas lereng Kelir yang dijual langsung.',
  },
];
---

<section class="wrap mt-section-s">
  <SectionHead
    label="UMKM warga"
    title="Usaha yang hidup di sekitar Rawa Pening"
    intro="Direktori usaha warga hasil pendampingan, lengkap dengan kontak WhatsApp penjual."
    href="/umkm"
    linkLabel="Buka direktori UMKM"
  />

  <ul class="mt-9 grid gap-x-6 gap-y-8 sm:grid-cols-3">
    {
      strip.map((item, index) => (
        <li>
          <a href="/umkm" class="group block">
            <div class="relative overflow-hidden border border-ink/20 bg-paper-light">
              <Figure
                src={item.src}
                alt={item.alt}
                ratio="aspect-[4/5]"
                sizes="(min-width: 640px) 32vw, 100vw"
                class="zoom-in"
              />
              <span
                class="num absolute left-2 top-2 bg-paper-light px-1.5 py-0.5 text-xs text-ink"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="mt-3 flex items-baseline justify-between gap-4 border-t border-ink/20 pt-2.5">
              <h3 class="text-xl leading-tight">{item.title}</h3>
              <span class="h-px w-5 shrink-0 bg-accent transition-transform duration-base ease-editorial group-hover:scale-x-150" aria-hidden="true" />
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.note}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
