---
const stages = [
  {
    phase: 'Fase 01',
    title: 'Penerjunan',
    description:
      'Mahasiswa dilepas ke Desa Banyubiru dan membangun kedekatan hangat dengan warga melalui hidup berdampingan sehari-hari.',
  },
  {
    phase: 'Fase 02',
    title: 'Sosialisasi',
    description:
      'Pemetaan kebutuhan warga, diskusi lintas prodi, dan penyusunan program yang benar-benar menjawab persoalan desa.',
  },
  {
    phase: 'Fase 03',
    title: 'Eksekusi Program',
    description:
      'Enam program kerja prodi diimplementasikan langsung di lapangan bersama warga, dari panel surya hingga digitalisasi UMKM.',
  },
  {
    phase: 'Fase 04',
    title: 'Gelar Karya / Expo',
    description:
      'Puncak pengabdian: pameran hasil karya dan inovasi terbuka bagi publik, stakeholder, dan warga Banyubiru.',
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
        Alur Pengabdian
      </span>
      <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl lg:text-4xl">
        Empat Tahap, Satu Perjalanan
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        Setiap langkah dirancang agar dampak pengabdian tumbuh berkelanjutan —
        dari kedatangan pertama hingga puncak Gelar Karya.
      </p>
    </div>

    <ol class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {stages.map((stage) => (
        <li class="relative rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
          <span class="inline-flex items-center rounded-full bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
            {stage.phase}
          </span>
          <h3 class="mt-5 text-xl font-bold tracking-tight text-slate-900">
            {stage.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {stage.description}
          </p>
          <div class="mt-6 flex items-center gap-1.5" aria-hidden="true">
            {stages.map((_, index) => (
              <span
                class:list={[
                  'h-1 rounded-full',
                  index < stages.indexOf(stage) + 1
                    ? 'w-6 bg-brand-600'
                    : 'w-2 bg-slate-200',
                ]}
              ></span>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>