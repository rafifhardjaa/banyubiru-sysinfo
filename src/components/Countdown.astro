---
const targetTimestamp = new Date('2026-08-25T09:00:00+07:00').getTime();

const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');
const compute = () => {
  const diff = Math.max(0, targetTimestamp - Date.now());
  return {
    hari: Math.floor(diff / 86_400_000),
    jam: Math.floor((diff % 86_400_000) / 3_600_000),
    menit: Math.floor((diff % 3_600_000) / 60_000),
    detik: Math.floor((diff % 60_000) / 1_000),
  };
};

const initial = compute();
---

<div class="mx-auto mt-10 max-w-2xl" data-countdown={targetTimestamp}>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5" data-countdown-boxes>
    <div class="rounded-2xl border border-white/10 bg-black/30 p-4 text-center backdrop-blur-md md:p-6">
      <p data-countdown-unit="hari" class="text-3xl font-black tabular-nums text-white md:text-5xl">{pad(initial.hari)}</p>
      <p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-200">Hari</p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-black/30 p-4 text-center backdrop-blur-md md:p-6">
      <p data-countdown-unit="jam" class="text-3xl font-black tabular-nums text-white md:text-5xl">{pad(initial.jam)}</p>
      <p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-200">Jam</p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-black/30 p-4 text-center backdrop-blur-md md:p-6">
      <p data-countdown-unit="menit" class="text-3xl font-black tabular-nums text-white md:text-5xl">{pad(initial.menit)}</p>
      <p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-200">Menit</p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-black/30 p-4 text-center backdrop-blur-md md:p-6">
      <p data-countdown-unit="detik" class="text-3xl font-black tabular-nums text-white md:text-5xl">{pad(initial.detik)}</p>
      <p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-200">Detik</p>
    </div>
  </div>

  <p
    class="hidden rounded-2xl border border-white/10 bg-black/30 p-6 text-center text-xl font-extrabold text-white backdrop-blur-md md:text-2xl"
    data-countdown-finished
  >
    🎉 Pameran Expo Sedang Berlangsung!
  </p>
</div>

<script>
  document.querySelectorAll('[data-countdown]').forEach((root) => {
    const target = Number(root.dataset.countdown || 0);
    const boxes = root.querySelector('[data-countdown-boxes]');
    const finished = root.querySelector('[data-countdown-finished]');
    const units = root.querySelectorAll('[data-countdown-unit]');

    const pad = (n) => String(Math.max(0, n)).padStart(2, '0');

    const timer = setInterval(() => {
      const diff = Math.max(0, target - Date.now());

      if (diff === 0) {
        clearInterval(timer);
        if (boxes) boxes.classList.add('hidden');
        if (finished) finished.classList.remove('hidden');
        return;
      }

      const values = [
        Math.floor(diff / 86_400_000),
        Math.floor((diff % 86_400_000) / 3_600_000),
        Math.floor((diff % 3_600_000) / 60_000),
        Math.floor((diff % 60_000) / 1_000),
      ];

      units.forEach((unit, index) => {
        unit.textContent = pad(values[index]);
      });
    }, 1000);
  });
</script>