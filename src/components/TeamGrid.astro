---
const teams = [
  {
    name: 'BEM FTI',
    role: 'Penggerak Utama Pengabdian',
    description:
      'Menjadi koordinator, memastikan setiap program berjalan selaras dan seluruh prodi bersinergi di lapangan.',
    initial: 'B',
    accent: 'bg-brand-700',
    members: 'BEM Fakultas Teknologi Informasi',
  },
  {
    name: 'Himpunan Teknik Energi & Infrastruktur',
    role: 'Mesin • Sipil • Elektro',
    description:
      'Menghadirkan solusi energi terbarukan, pembangunan akses, dan penerangan pintar bagi desa.',
    initial: 'EI',
    accent: 'bg-brand-600',
    members: 'HMM • HMS • HME',
  },
  {
    name: 'Himpunan Ruang & Pangan',
    role: 'Arsitektur • Teknologi Pangan',
    description:
      'Menata ruang desa dan mengangkat nilai tambah olahan pangan lokal agar berdaya saing.',
    initial: 'RP',
    accent: 'bg-brand-500',
    members: 'HMA • HMT',
  },
  {
    name: 'Himpunan Teknologi Digital',
    role: 'Teknik Informatika',
    description:
      'Membangun solusi IoT, digitalisasi UMKM, dan menjadi motor Expo Gelar Karya.',
    initial: 'TI',
    accent: 'bg-brand-800',
    members: 'HMTI',
  },
];
---

<section class="bg-slate-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-brand-700">
        Tim Pelaksana
      </span>
      <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl lg:text-4xl">
        BEM & Enam Himpunan dalam Satu Gerak
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        Di balik setiap aksi di lapangan, ada sinergi organisasi kemahasiswaan
        yang saling mengisi kekuatan.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {teams.map((team) => (
        <li class="flex flex-col rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
          <span
            class:list={[
              'flex h-16 w-16 items-center justify-center rounded-2xl text-2xl font-extrabold text-white shadow-sm',
              team.accent,
            ]}
            aria-hidden="true"
          >
            {team.initial}
          </span>
          <h3 class="mt-6 text-lg font-bold leading-snug tracking-tight text-slate-900">
            {team.name}
          </h3>
          <p class="mt-1 text-xs font-bold uppercase tracking-widest text-brand-700">
            {team.role}
          </p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">
            {team.description}
          </p>
          <p class="mt-5 border-t border-slate-100 pt-4 text-xs font-semibold text-slate-400">
            {team.members}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>