---
interface Props {
  date: string;
  title: string;
  body: string;
  href: string;
  linkLabel: string;
}

const { date, title, body, href, linkLabel } = Astro.props;
---

<section class="wrap mt-section-s">
  <div class="notebook entry relative overflow-hidden">
    <span class="absolute inset-x-0 top-0 h-[3px] bg-accent" aria-hidden="true" />
    <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-12 lg:p-12">
      <div class="max-w-2xl">
        <p class="label flex items-center gap-2.5">
          <span class="h-px w-6 shrink-0 bg-accent" aria-hidden="true" />
          {date}
        </p>
        <h2 class="mt-3 text-[var(--text-section)] leading-[1.05]">{title}</h2>
        <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-soft">{body}</p>
      </div>

      <a href={href} class="btn-solid group w-full shrink-0 sm:w-auto">
        {linkLabel}
        <svg
          class="h-4 w-4 transition-transform duration-base ease-editorial group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>
