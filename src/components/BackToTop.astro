<button
  type="button"
  data-back-to-top
  aria-label="Kembali ke atas halaman"
  class="fixed bottom-8 right-8 z-50 rounded-full bg-brand-700 p-3.5 text-white opacity-0 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-brand-800 pointer-events-none"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<script>
  function updateButton() {
    const button = document.querySelector('[data-back-to-top]');
    if (!button) return;
    const show = window.scrollY > 300;
    button.classList.toggle('opacity-0', !show);
    button.classList.toggle('pointer-events-none', !show);
    button.classList.toggle('opacity-100', show);
    button.classList.toggle('pointer-events-auto', show);
  }

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-back-to-top]');
    if (button) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  document.addEventListener('astro:page-load', () => {
    if (window._bttScrollReady) return;
    window._bttScrollReady = true;
    window.addEventListener('scroll', updateButton, { passive: true });
    updateButton();
  });
</script>