---
import type { CollectionEntry } from 'astro:content';
import Figure from './Figure.astro';
import { prokerPhoto } from '../lib/prokerPhoto';

interface Props {
  item: CollectionEntry<'proker'>;
  index: number;
  flip?: boolean;
}

const { item, index, flip = false } = Astro.props;

const photo = prokerPhoto(item.data.kategori);
const done = item.data.progressPercent >= 100;
---

<article class="grid gap-6 border-t border-line py-8 lg:grid-cols-12 lg:items-center lg:gap-10">
  <a
    href={`/proker/${item.id}`}
    class:list={['group block lg:col-span-5', flip ? 'lg:order-2' : '']}
    tabindex="-1"
    aria-hidden="true"
  >
    <Figure
      src={photo}
      alt=""
      ratio="aspect-[4/3]"
      sizes="(min-width: 1024px) 40vw, 100vw"
    />
  </a>

  <div class:list={['lg:col-span-7', flip ? 'lg:order-1' : '']}>
    <p class="label">
      {String(index + 1).padStart(2, '0')} · {item.data.prodi}
    </p>
    <h3 class="mt-2 font-display text-2xl font-semibold leading-[1.15] tracking-tight sm:text-3xl">
      <a href={`/proker/${item.id}`} class="transition-colors hover:text-danau">
        {item.data.title}
      </a>
    </h3>
    <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-ink-soft">
      {item.data.ringkasan}
    </p>

    <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div class="flex gap-2">
        <dt class="text-ink-mute">Lokasi</dt>
        <dd class="font-semibold text-ink">{item.data.lokasi}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-ink-mute">Status</dt>
        <dd class:list={['font-semibold', done ? 'text-danau' : 'text-ink']}>
          {item.data.status} · {item.data.progressPercent}%
        </dd>
      </div>
    </dl>

    <a href={`/proker/${item.id}`} class="link-more mt-2">
      Baca detail program
    </a>
  </div>
</article>
