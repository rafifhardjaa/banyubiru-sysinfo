---
const stats = [
  { value: '6', label: 'Program Studi Berkolaborasi' },
  { value: '14', label: 'Hari Pengabdian Nyata' },
  { value: '1', label: 'Expo Gelar Karya' },
  { value: '80+', label: 'Mahasiswa Terjun Lapangan' },
];
---

<section class="bg-slate-900 py-16 text-white lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <dl class="grid grid-cols-1 gap-10 text-center sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col items-center rounded-3xl border border-slate-800 bg-slate-800/40 px-6 py-10 backdrop-blur-sm">
          <dd class="text-5xl font-extrabold tracking-tight text-brand-500 md:text-6xl">
            {stat.value}
          </dd>
          <dt class="mt-3 text-sm font-semibold text-slate-400">
            {stat.label}
          </dt>
        </div>
      ))}
    </dl>
  </div>
</section>