---
const path = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program Kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Berita' },
  { href: '/kontak', label: 'Kontak' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="text-xl font-extrabold tracking-tight text-slate-900">
      FTI<span class="text-brand-700">Banyubiru</span>.
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                isActive(link.href)
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/berita"
        class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        Portal Berita
      </a>
    </div>

    <label for="nav-toggle" class="cursor-pointer p-2 text-slate-700 lg:hidden" aria-label="Buka menu">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </label>
    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <div class="fixed inset-x-0 top-16 hidden border-b border-slate-100 bg-white/95 px-4 pb-6 pt-2 backdrop-blur-md peer-checked:block lg:hidden">
      <ul class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-xl px-4 py-3 text-sm font-semibold transition-colors',
                isActive(link.href)
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/berita"
        class="mt-3 flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-brand-800"
      >
        Portal Berita
      </a>
    </div>
  </nav>
</header>