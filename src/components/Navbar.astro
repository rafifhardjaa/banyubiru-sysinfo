---
const path = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Catatan' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-ink/25 bg-paper/95 backdrop-blur-sm">
  <nav class="wrap flex h-[68px] items-center justify-between gap-6" aria-label="Navigasi utama">
    <a href="/" class="flex items-baseline gap-2.5" aria-label="Banyubiru, Jurnal Pengabdian FTI, beranda">
      <span class="font-display text-[1.55rem] font-semibold leading-none tracking-tightest text-ink">
        Banyubiru
      </span>
      <span class="hidden border-l border-ink/25 pl-2.5 text-[11px] font-medium leading-[1.25] text-ink-mute sm:block">
        Jurnal pengabdian<br />FTI
      </span>
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-[44px] items-center border-b-2 text-[15px] transition-colors',
                isActive(link.href)
                  ? 'border-accent font-medium text-ink'
                  : 'border-transparent text-ink-soft hover:border-ink/30 hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/kontak"
      aria-current={isActive('/kontak') ? 'page' : undefined}
      class:list={[
        'btn btn-solid hidden min-h-[44px] px-4 lg:inline-flex',
        isActive('/kontak') ? 'shadow-none' : '',
      ]}
    >
      Kontak posko
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="group inline-flex min-h-[40px] items-center gap-2 rounded-pill border border-ink/30 bg-paper-2 px-3 text-sm font-medium text-ink transition-colors hover:bg-paper-deep lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span data-menu-label>Menu</span>
      <span class="relative block h-4 w-4" aria-hidden="true">
        <span class="absolute inset-x-0 top-0 h-0.5 rounded-full bg-current transition-transform duration-300 ease-editorial group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
        <span class="absolute inset-x-0 top-[7px] h-0.5 rounded-full bg-current transition-[opacity,transform] duration-300 ease-editorial group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0"></span>
        <span class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-current transition-transform duration-300 ease-editorial group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
      </span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    data-state="closed"
    inert
    class="invisible grid grid-rows-[0fr] overflow-hidden border-t border-ink/15 bg-paper opacity-0 transition-[grid-template-rows,opacity,visibility] duration-300 ease-editorial data-[state=open]:visible data-[state=open]:grid-rows-[1fr] data-[state=open]:opacity-100 lg:hidden"
  >
    <div class="min-h-0">
      <div class="wrap py-4">
        <ul class="divide-y divide-line border-y border-line">
          {
            [...navLinks, { href: '/kontak', label: 'Kontak posko' }].map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-[52px] items-center justify-between gap-4 text-lg',
                    isActive(link.href) ? 'font-semibold text-ink' : 'text-ink-soft',
                  ]}
                >
                  {link.label}
                  {isActive(link.href) && (
                    <span class="h-px w-6 shrink-0 bg-accent" aria-hidden="true" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="pt-4 text-sm leading-relaxed text-ink-mute">
          Posko Pengmas FTI, Balai Desa Kebondowo, Kecamatan Banyubiru,
          Kabupaten Semarang.
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const label = document.querySelector('[data-menu-label]');
    if (!toggle || !menu) return;

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.state = open ? 'open' : 'closed';
      menu.toggleAttribute('inert', !open);
      if (label) label.textContent = open ? 'Tutup' : 'Menu';
    };

    // ClientRouter keeps the document alive across navigations, so listeners
    // are tied to a per-page controller instead of piling up.
    const controller = new AbortController();
    const { signal } = controller;

    setOpen(false);

    toggle.addEventListener('click', () => setOpen(!isOpen()), { signal });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    }, { signal });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen()) setOpen(false);
    }, { signal });

    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal });
  });
</script>
