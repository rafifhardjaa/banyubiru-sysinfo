---
const path = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/proker', label: 'Program Kerja' },
  { href: '/umkm', label: 'UMKM' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/berita', label: 'Berita' },
  { href: '/kontak', label: 'Kontak' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur-md">
  <nav id="nav-root" class="group mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="text-xl font-extrabold tracking-tight text-slate-900">
      FTI<span class="text-brand-700">Banyubiru</span>.
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                isActive(link.href)
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/berita"
        class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        Portal Berita
      </a>
    </div>

    <button
      id="menu-toggle"
      class="flex flex-col items-center justify-center gap-[6px] p-2 lg:hidden"
      aria-label="Buka menu"
      type="button"
    >
      <span class="block h-0.5 w-6 origin-center rounded-full bg-slate-700 transition-all duration-300 ease-in-out group-[.is-open]:translate-y-[7px] group-[.is-open]:rotate-45"></span>
      <span class="block h-0.5 w-6 origin-center rounded-full bg-slate-700 transition-all duration-300 ease-in-out group-[.is-open]:opacity-0"></span>
      <span class="block h-0.5 w-6 origin-center rounded-full bg-slate-700 transition-all duration-300 ease-in-out group-[.is-open]:-translate-y-[7px] group-[.is-open]:-rotate-45"></span>
    </button>

    <div
      id="mobile-menu"
      class="pointer-events-none absolute inset-x-0 top-16 z-40 max-h-0 -translate-y-4 overflow-hidden border-b border-slate-100 bg-white/95 opacity-0 shadow-xl backdrop-blur-lg transition-all duration-300 ease-in-out group-[.is-open]:pointer-events-auto group-[.is-open]:max-h-[500px] group-[.is-open]:translate-y-0 group-[.is-open]:opacity-100 lg:hidden"
    >
      <div class="rounded-b-3xl px-6 pb-6 pt-2">
        <ul class="flex flex-col gap-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block rounded-xl px-4 py-3 text-sm font-semibold transition-colors',
                  isActive(link.href)
                    ? 'bg-brand-50 text-brand-700'
                    : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/berita"
          class="mt-3 flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-brand-800"
        >
          Portal Berita
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('nav-root');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');

    if (!root || !toggle || !menu) return;
    if (root.dataset.navReady) return;
    root.dataset.navReady = 'true';

    const open = () => {
      root.classList.add('is-open');
      toggle.setAttribute('aria-label', 'Tutup menu');
    };

    const close = () => {
      root.classList.remove('is-open');
      toggle.setAttribute('aria-label', 'Buka menu');
    };

    toggle.addEventListener('click', () => {
      root.classList.contains('is-open') ? close() : open();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) close();
    });
  });
</script>